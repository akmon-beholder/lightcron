# Copy this file to .env and fill in the values for local development.
# Never commit .env to source control.

# Direct PostgreSQL connection (used by Alembic migrations and FK integrity check)
DATABASE_URL=postgresql+asyncpg://lightcron:lightcron@localhost:5432/lightcron

# pgBouncer connection (used by scheduler and worker at runtime)
# Must be session mode — transaction mode breaks SELECT FOR UPDATE SKIP LOCKED
PGBOUNCER_URL=postgresql+asyncpg://lightcron:lightcron@localhost:6432/lightcron

# Scheduler: allowed CORS origin for the web UI (no trailing slash)
# DO NOT use "*" in production
LIGHTCRON_UI_ORIGIN=http://localhost:5173

# Worker: maximum number of concurrent jobs this worker instance may run
WORKER_CONCURRENCY=2

# Frontend (Vite): base URL of the scheduler REST API
VITE_API_BASE_URL=http://localhost:8000
